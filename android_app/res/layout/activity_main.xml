<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:paddingTop="6dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginRight="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIN OUT 2"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ECU &amp; TCU Pinout Master Database"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_fav_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_normal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="★ 0"
            android:textColor="@color/accent_orange"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Mode Switcher Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_item"
        android:padding="3dp"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/tab_cfpm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_active"
            android:text="🚗 CFPM GBE AUTO (934)"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/tab_general"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_normal"
            android:text="⚡ Catalogue Général (2813)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Mode 1: CFPM Interactive Web App (934 Calculateurs) -->
        <WebView
            android:id="@+id/wv_cfpm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Mode 2: General Catalog (2813 Calculateurs) -->
        <LinearLayout
            android:id="@+id/ll_general_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Search Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="8dp"
                android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <TextView
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:padding="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Categories Chips Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/ll_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_active"
                android:text="Tous (2813)"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginRight="6dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/chip_ktag"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_normal"
                android:text="K-TAG (1987)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginRight="6dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/chip_bench"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Bench Mod 71 (174)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginRight="6dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/chip_boot"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Boot Tricore (169)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginRight="6dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/chip_hexportal"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_normal"
                android:text="HexPortal (299)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginRight="6dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/chip_dm"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_normal"
                android:text="DM Pinouts (184)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginRight="6dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/chip_fav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_normal"
                android:text="★ Favoris"
                android:textColor="@color/accent_orange"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Brands Quick Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/ll_brands"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/brand_all"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_active"
                android:text="Toutes Marques"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_bosch"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Bosch"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_siemens"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Siemens / Conti"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_delphi"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Delphi"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_denso"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Denso"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_marelli"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Marelli"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_psa"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="PSA (Peugeot/Citroën)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_vag"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="VAG (VW/Audi)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_bmw"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="BMW"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_mercedes"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Mercedes"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_renault"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Renault"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:layout_marginRight="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/brand_ford"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_normal"
                android:text="Ford"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Count Header -->
    <TextView
        android:id="@+id/tv_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2813 calculateurs trouvés"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        android:paddingLeft="4dp" />

    <!-- List of Pinouts -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/no_results"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

        </LinearLayout> <!-- ll_general_container -->

    </FrameLayout> <!-- content FrameLayout -->

</LinearLayout>
