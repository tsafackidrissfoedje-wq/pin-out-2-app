<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_item"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top line: Category and Favorite Star -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/item_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="PCM Flash Bench"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_mcu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_badge"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="TC1797"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/item_img_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 1"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/item_btn_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☆"
            android:textColor="@color/accent_orange"
            android:textSize="18sp"
            android:padding="4dp" />
    </LinearLayout>

    <!-- ECU Title -->
    <TextView
        android:id="@+id/item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EDC17C10 TC1797 PSA Peugeot Citroen"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Brands & Summary snippet -->
    <TextView
        android:id="@+id/item_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bosch EDC17C10 Bench Mode Connection Pinout"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="2" />

</LinearLayout>
